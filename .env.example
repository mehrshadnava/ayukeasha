# ---------- Core ----------
# Postgres (Neon: neon.tech, region Mumbai). Pooled string (host has -pooler) for the app,
# direct string (no -pooler) for schema changes. Use a separate Neon branch for local dev.
DATABASE_URL=""
DIRECT_URL=""
# Public URL of the site. Optional on Netlify (falls back to the deploy URL); set it once you use your own domain.
APP_URL=""
# Long random string used to sign login sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@ayurkesha.com"
ADMIN_PASSWORD=""

# ---------- Store rules ----------
SHIPPING_FEE_INR=49
FREE_SHIPPING_ABOVE_INR=450
RETURN_WINDOW_DAYS=7

# ---------- Business details (invoice + Shiprocket pickup) ----------
SELLER_NAME="Aditya Enterprises"
SELLER_ADDRESS="Sector-12, Kharghar, Navi Mumbai"
SELLER_STATE="Maharashtra"
SELLER_PINCODE="410210"
SELLER_GSTIN=""
SELLER_PHONE="9619178792"
SELLER_EMAIL="customercare@ayurkesha.com"

# ---------- Razorpay (dashboard.razorpay.com -> Settings -> API Keys) ----------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Settings -> Webhooks: URL = {APP_URL}/api/webhooks/razorpay, events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Shiprocket (app.shiprocket.in -> Settings -> API -> Configure, create an API user) ----------
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Exact "Pickup Location" nickname from Shiprocket -> Settings -> Pickup Addresses
SHIPROCKET_PICKUP_LOCATION="Primary"
# Settings -> API -> Webhooks: URL = {APP_URL}/api/webhooks/courier, token = this value (sent as x-api-key)
SHIPROCKET_WEBHOOK_TOKEN=""

# ---------- Test mode ----------
# When Razorpay / Shiprocket keys are empty, "true" lets you simulate payments and shipments.
# Must be "false" (or removed) in production.
ALLOW_TEST_MODE="true"

# ---------- Email (optional; without SMTP, emails are printed to the server console) ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AyurKesha <customercare@ayurkesha.com>"
